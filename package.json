{
  "name": "morning-recall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interview field guides and worked system designs, as a browsable library.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "diagrams": "python3 tools/diagrams/build.py",
    "diagrams:verify": "node tools/diagrams/verify.mjs",
    "audio:voices": "node scripts/audio/voices.mjs",
    "audio:synth": "node scripts/audio/synth.mjs",
    "audio:feed": "node scripts/audio/feed.mjs",
    "audio:publish": "node scripts/audio/publish.mjs"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2",
    "rehype-highlight": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "highlight.js": "^11.10.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
